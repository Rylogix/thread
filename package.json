{
  "name": "thread-webmcp",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12 <25"
  },
  "private": true,
  "type": "module",
  "description": "THREAD - an agent-native execution graph for humans and AI.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src worker tests --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply thread-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply thread-production --remote"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
